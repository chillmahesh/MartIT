# ==============================================================================
# MartIT — Environment Configuration Template
# Copy this file to .env.local for local frontend development, or .env for local backend.
# NEVER commit real credentials, service-role keys, or secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel / Local Vite)
# Note: Only variables prefixed with VITE_* are exposed to browser code.
# ------------------------------------------------------------------------------
# Base URL of the authoritative API (e.g., https://martit-api.onrender.com or http://localhost:4000).
# Leave empty to keep using the in-browser mock server fallback.
VITE_API_BASE_URL=https://martit.vercel.app/

# Public display label shown on UPI QR payment screens (not a secret).
VITE_UPI_PAYEE_NAME=MartIT

# Approved merchant UPI Payee VPA (e.g. your-vpa@oksbi).
# If unconfigured, QR generation safely highlights this configuration requirement.
VITE_UPI_PAYEE_VPA=omkarrakhonde485@oksbi

# ------------------------------------------------------------------------------
# 2. BACKEND API ENVIRONMENT VARIABLES (Render Node.js/Express)
# These are SERVER-ONLY and must NEVER be exposed to the browser or prefixed with VITE_.
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Allowed frontend origins for CORS (comma-separated URLs, e.g. https://martit.vercel.app,http://localhost:5173).
FRONTEND_ORIGINS=https://martit.vercel.app/
# ------------------------------------------------------------------------------
# 3. SUPABASE CONFIGURATION (Backend Only)
# ------------------------------------------------------------------------------
# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API).
SUPABASE_URL=https://uuuqaeptpripmvavihza.supabase.co

# Supabase Public Anonymous API Key (safe for public clients / JWT verification).
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InV1dXFhZXB0cHJpcG12YXZpaHphIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTE2MjM2NjMsImV4cCI6MjEwNzE5OTY2M30.1B5hhXKbJrjcR3dfnUsR7R__jaBA7Wjbnuso_NGNyz0

# Supabase Service Role Secret Key (SERVER-SIDE ONLY - provides elevated access).
# NEVER place this in frontend code, public bundles, or client environment variables.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InV1dXFhZXB0cHJpcG12YXZpaHphIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MTYyMzY2MywiZXhwIjoyMTA3MTk5NjYzfQ.UaH9oLMjj_d1z8bW43qkbfCmIG0XaH9kqNvbNCd29b4

# Direct PostgreSQL connection string for applying migrations (optional/manual):
# postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:MartIT@2026@db.uuuqaeptpripmvavihza.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 4. OPTIONAL / FUTURE INTEGRATION VARIABLES
# Unused until downstream integrations are confirmed and deployed.
# ------------------------------------------------------------------------------
# Multi-store checkout feature gate (default: false until full routing and E2E tested).
FEATURE_MULTI_STORE_CHECKOUT=false

# Physical road/walking routing provider (e.g. mapbox, openrouteservice).
ROUTING_PROVIDER=
ROUTING_MODE=walking

# Protected server webhook URL for incoming Make.com UPI reconciliation.
MAKE_VERIFICATION_WEBHOOK_URL=
