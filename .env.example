# ==============================================================================
# MartIT — Environment Configuration Template
# 
# DASHBOARD ASSIGNMENT MATRIX:
#   - Section 1 (VITE_*): Vercel Dashboard -> Settings -> Environment Variables
#   - Section 2 & 3: Render Dashboard -> Environment Settings (Secret / Server-Only)
#   - Local Testing: Copy to .env.local (frontend) or .env (backend) - both gitignored.
#
# CRITICAL SECURITY RULES:
#   - NEVER commit real credentials, service-role keys, or database passwords to Git.
#   - Use placeholders only in this file.
#   - Never prefix server-only credentials with VITE_.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel Dashboard / Local .env.local)
# Note: Only variables prefixed with VITE_* are exposed to client browser bundles.
# ------------------------------------------------------------------------------
# Base URL of the authoritative API (e.g., https://martit-api.onrender.com).
# Leave EMPTY to keep using the in-browser mock server fallback during development/demo.
VITE_API_BASE_URL=

# Supabase Project URL for client authentication (public, safe in browser bundle).
# Required in remote API mode. Leave empty to use mock authentication.
VITE_SUPABASE_URL=

# Supabase Anonymous Public API Key (public anon key, safe in browser bundle).
# NEVER place the SUPABASE_SERVICE_ROLE_KEY here.
VITE_SUPABASE_ANON_KEY=

# Public display label shown on UPI QR payment screens (not a secret).
VITE_UPI_PAYEE_NAME=MartIT

# Approved merchant UPI Payee VPA (e.g. merchant@oksbi).
# If unconfigured, QR generation safely highlights this configuration requirement.
VITE_UPI_PAYEE_VPA=

# ------------------------------------------------------------------------------
# 2. BACKEND API ENVIRONMENT VARIABLES (Render Dashboard / Local .env)
# These are SERVER-ONLY and must NEVER be exposed to the browser or prefixed with VITE_.
# ------------------------------------------------------------------------------
PORT=10000
NODE_ENV=development

# Allowed frontend origins for CORS (comma-separated HTTPS URLs in production).
# In Render Dashboard: set to your actual Vercel URL, e.g. https://martit.vercel.app
# In local development: http://localhost:5173,http://localhost:3000
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 3. SUPABASE CONFIGURATION (Render Dashboard ONLY / Local .env)
# ------------------------------------------------------------------------------
# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API).
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous API Key (used on backend for JWT verification).
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Secret Key (SERVER-SIDE ONLY - provides elevated access).
# NEVER place this in frontend code, public bundles, or client environment variables.
# In Render Dashboard: Add as a secret environment variable.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Direct PostgreSQL connection string for applying migrations manually (optional):
# postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
DATABASE_URL=

# ------------------------------------------------------------------------------
# 4. OPTIONAL / FUTURE INTEGRATION VARIABLES (Render Dashboard)
# ------------------------------------------------------------------------------
# Multi-store checkout feature gate (default: false until full routing and E2E tested).
FEATURE_MULTI_STORE_CHECKOUT=false

# Physical road/walking routing provider (e.g. mapbox, openrouteservice).
ROUTING_PROVIDER=
ROUTING_MODE=walking

# Protected server webhook URL for incoming Make.com UPI reconciliation.
MAKE_VERIFICATION_WEBHOOK_URL=
